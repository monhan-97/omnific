{
  "name": "@omnific/eslint-plugin-jsx-a11y",
  "version": "0.2.1",
  "description": "JSX accessibility ESLint plugin for Omnific",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "jsx",
    "a11y",
    "eslint",
    "eslint-plugin",
    "accessibility"
  ],
  "author": "monhan-97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monhan-97/omnific.git",
    "directory": "packages/eslint-plugin-jsx-a11y"
  },
  "bugs": {
    "url": "https://github.com/monhan-97/omnific.git/issues"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rules/*": {
      "types": "./dist/rules/*.d.ts",
      "import": "./dist/rules/*.js",
      "default": "./dist/rules/*.js"
    },
    "./util/*": {
      "types": "./dist/util/*.d.ts",
      "import": "./dist/util/*.js",
      "default": "./dist/util/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnific/utils": "workspace:*",
    "aria-query": "^5.3.2",
    "axobject-query": "^4.1.0",
    "damerau-levenshtein": "^1.0.8",
    "jsx-ast-utils-x": "^0.1.0",
    "language-tags": "^2.1.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@omnific/tsconfig": "workspace:*",
    "@types/aria-query": "^5.0.4",
    "@types/damerau-levenshtein": "^1.0.2",
    "@types/estree": "^1.0.10",
    "@types/estree-jsx": "^1.0.5",
    "@types/jsx-ast-utils": "^3.3.1",
    "@types/language-tags": "^1.0.4",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/parser": "^8.72.1"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  }
}
