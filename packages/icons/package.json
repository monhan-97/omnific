{
  "name": "@omnific/icons",
  "version": "0.1.0",
  "description": "React icon components for Omnific",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "icons",
    "svg"
  ],
  "author": "monhan-97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monhan-97/omnific.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/monhan-97/omnific.git/issues"
  },
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./EyeIcon": {
      "types": "./dist/EyeIcon.d.ts",
      "import": "./dist/EyeIcon.js",
      "default": "./dist/EyeIcon.js"
    },
    "./EyeOffIcon": {
      "types": "./dist/EyeOffIcon.d.ts",
      "import": "./dist/EyeOffIcon.js",
      "default": "./dist/EyeOffIcon.js"
    },
    "./LoadingIcon": {
      "types": "./dist/LoadingIcon.d.ts",
      "import": "./dist/LoadingIcon.js",
      "default": "./dist/LoadingIcon.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "cd docs && react-scripts dev",
    "docs:build": "cd docs && react-scripts build",
    "docs:preview": "cd docs && react-scripts dev",
    "docs:typecheck": "pnpm typecheck",
    "docs:lint": "eslint docs/react-scripts.config.ts docs/src",
    "docs:test": "vitest run --root ../.. packages/icons/docs/src"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@omnific/react-scripts": "workspace:*",
    "@omnific/tsconfig": "workspace:*",
    "@omnific/utils": "workspace:*",
    "@swc/helpers": "0.5.23",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "react": "^19.3.0",
    "react-dom": "19.3.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "not dead"
  ]
}
