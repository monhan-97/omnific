{
  "name": "@omnific/react-scripts",
  "version": "0.2.1",
  "description": "React app scripts based on Rspack",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "rspack",
    "scripts"
  ],
  "author": "monhan-97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monhan-97/omnific.git",
    "directory": "packages/react-scripts"
  },
  "bugs": {
    "url": "https://github.com/monhan-97/omnific.git/issues"
  },
  "bin": {
    "react-scripts": "./dist/index.js"
  },
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.config.mjs",
    "release": "pnpm publish --access public",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@omnific/types": "workspace:*",
    "@rspack/cli": "^2.1.2",
    "@rspack/core": "^2.1.2",
    "@rspack/dev-server": "^2.1.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@tailwindcss/postcss": "^4.3.2",
    "get-port": "^7.2.0",
    "postcss": "^8.5.16",
    "postcss-loader": "^8.2.0",
    "pretty-bytes": "^7.1.0",
    "prompts": "^2.4.2",
    "react-refresh": "^0.18.0",
    "sass-embedded": "^1.100.0",
    "sass-loader": "^17.0.0",
    "ts-checker-rspack-plugin": "^1.5.1",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@omnific/tsconfig": "workspace:*",
    "@types/prompts": "^2.4.9"
  }
}
