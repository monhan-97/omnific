{
  "name": "@omnific/react-scripts",
  "version": "0.4.0",
  "description": "React app scripts based on Rspack",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "rspack",
    "scripts"
  ],
  "author": "monhan-97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monhan-97/omnific.git",
    "directory": "packages/react-scripts"
  },
  "bugs": {
    "url": "https://github.com/monhan-97/omnific.git/issues"
  },
  "bin": {
    "react-scripts": "./bin.mjs"
  },
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "bin.mjs",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.config.mjs",
    "release": "pnpm publish --access public",
    "test": "vitest run --root ../.. packages/react-scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@omnific/types": "workspace:*",
    "@omnific/utils": "workspace:*",
    "@rspack/core": "^2.1.8",
    "@rspack/dev-server": "^2.2.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "get-port": "^7.2.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.0",
    "react-refresh": "^0.18.0",
    "rspack-merge": "^1.0.1",
    "ts-checker-rspack-plugin": "^1.6.0"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "sass-embedded": "^1.100.0",
    "sass-loader": "^17.0.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    },
    "sass-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@omnific/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "sass-embedded": "^1.100.0",
    "sass-loader": "^17.0.0",
    "tailwindcss": "^4.3.3"
  }
}
