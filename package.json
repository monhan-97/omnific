{
  "name": "omnific",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run --filter=\"./packages/**/*\" build",
    "typecheck": "pnpm build && pnpm run --filter=\"./packages/**/*\" typecheck",
    "lint:fix": "eslint . --fix --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/build/**\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "upgrade-workspace": "pnpm --filter=\"./packages/**/*\" update --interactive --latest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@omnific/eslint-config": "workspace:*",
    "@omnific/prettier-config": "workspace:*",
    "@omnific/tsconfig": "workspace:*",
    "@omnific/types": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
